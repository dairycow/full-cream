# Interactive Brokers Configuration
# Fill in these values with your IB Paper Trading account details
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
IB_ACCOUNT=YOUR_ACCOUNT_ID_HERE  # e.g., DU123456

# Trading Parameters
PAPER_TRADING=true
MAX_POSITION_SIZE_PERCENT=10
MAX_DAILY_LOSS_PERCENT=5
MIN_GAP_PERCENT=3.0
MAX_GAP_PERCENT=15.0
MAX_CONCURRENT_POSITIONS=3
RISK_PER_TRADE_PERCENT=2.0

# Market Hours (AEST/AEDT - adjust for timezone)
MARKET_OPEN_TIME=10:00
MARKET_CLOSE_TIME=16:00
EOD_CLOSE_TIME=15:50

# Opening Range Configuration
OPENING_RANGE_MINUTES=15  # First 15 minutes (10:00-10:15 AEST)

# Database Configuration
DATABASE_PATH=data/asx_trader.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_PATH=data/logs

# Alert Configuration (Optional - for future use)
# ALERT_EMAIL=your-email@example.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-app-password

# Droplet/Server Configuration (Optional)
# DROPLET_IP=YOUR_DROPLET_IP_HERE
# SSH_KEY_PATH=/path/to/your/ssh/key
